# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.

# Supabase dashboard -> Project Settings -> Data API (or "API"): Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API Keys: the "anon" / "publishable" key.
# Safe to expose in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase dashboard -> Project Settings -> API Keys: the "service_role" / "secret" key.
# SERVER ONLY. It bypasses Row Level Security. Used by `npm run seed:demo`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Where the app runs. Use your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic Console (https://console.anthropic.com) -> API Keys -> Create Key. Starts with "sk-ant-".
# SERVER ONLY (no NEXT_PUBLIC_ prefix, so it never reaches the browser). Powers AI Extract.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Stripe (use TEST mode keys while developing: they start with sk_test_) ---
# Stripe dashboard -> Developers -> API keys -> Secret key. SERVER ONLY.
STRIPE_SECRET_KEY=sk_test_your-secret-key

# Signing secret for /api/stripe/webhook. Starts with whsec_.
# Local: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# Production: Stripe dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Price IDs (start with price_) from Stripe dashboard -> Product catalog.
# One product per plan, each with a monthly and a yearly recurring price:
# Starter $79/mo, $790/yr; Team $199/mo, $1,990/yr; Business $499/mo, $4,990/yr.
STRIPE_PRICE_STARTER_MONTHLY=price_your-starter-monthly-id
STRIPE_PRICE_STARTER_ANNUAL=price_your-starter-annual-id
STRIPE_PRICE_TEAM_MONTHLY=price_your-team-monthly-id
STRIPE_PRICE_TEAM_ANNUAL=price_your-team-annual-id
STRIPE_PRICE_BUSINESS_MONTHLY=price_your-business-monthly-id
STRIPE_PRICE_BUSINESS_ANNUAL=price_your-business-annual-id

# Before Phase 2 these were the only prices. Keep them set while any subscription
# still uses them, so the webhook recognizes those subscriptions (as monthly).
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=

# "true" turns on Stripe Tax at checkout (set up Stripe Tax first). Optional.
STRIPE_AUTOMATIC_TAX=

# --- Contact addresses shown on /contact, /terms, /privacy and /security ---
# Leave one blank and the site shows "Address coming soon" instead of a placeholder.
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SECURITY_EMAIL=

# --- Demo account (used by `npm run seed:demo` and the browser tests) ---
# The demo login's email and password. The password must be at least 10 characters.
# The app also uses DEMO_EMAIL to lock that account's email, password and deletion.
DEMO_EMAIL=demo@demo.com
DEMO_PASSWORD=choose-a-demo-password

# --- Email (optional): invites, notifications, digests, trial and payment notices ---
# Resend (https://resend.com) -> API Keys. SERVER ONLY. Leave blank and invites still
# work (the app shows the invite link to copy) and notifications stay in-app only.
RESEND_API_KEY=
# Sender for invite emails. Must be on a domain verified in Resend. Blank uses
# Resend's test sender, which can only email your own Resend account address.
EMAIL_FROM=Forgeboard <invites@your-domain.com>

# --- Daily jobs ---
# Any long random string. SERVER ONLY. Vercel Cron sends it as a Bearer token to
# /api/cron/daily (due-date digests, trial-ending warnings, queued emails).
# Without it the route refuses every call. Generate one: openssl rand -hex 32
CRON_SECRET=

# --- Error monitoring (optional) ---
# Sentry -> Project Settings -> Client Keys (DSN). Leave blank to turn monitoring off.
NEXT_PUBLIC_SENTRY_DSN=
