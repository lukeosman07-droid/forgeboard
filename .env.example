# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.

# Supabase dashboard -> Project Settings -> Data API (or "API"): Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API Keys: the "anon" / "publishable" key.
# Safe to expose in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase dashboard -> Project Settings -> API Keys: the "service_role" / "secret" key.
# SERVER ONLY. It bypasses Row Level Security. Used by `npm run seed:demo`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Where the app runs. Use your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic Console (https://console.anthropic.com) -> API Keys -> Create Key. Starts with "sk-ant-".
# SERVER ONLY (no NEXT_PUBLIC_ prefix, so it never reaches the browser). Powers AI Extract.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Stripe (use TEST mode keys while developing: they start with sk_test_) ---
# Stripe dashboard -> Developers -> API keys -> Secret key. SERVER ONLY.
STRIPE_SECRET_KEY=sk_test_your-secret-key

# Signing secret for /api/stripe/webhook. Starts with whsec_.
# Local: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# Production: Stripe dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Price IDs (start with price_) from Stripe dashboard -> Product catalog -> each product's monthly price.
STRIPE_PRICE_TEAM=price_your-team-price-id
STRIPE_PRICE_BUSINESS=price_your-business-price-id
